<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="de.haw_hamburg.sketchtomapgen.controller.ResultController">
    <center>
        <StackPane>
            <!-- Canvas to display the final result -->
            <Canvas fx:id="resultCanvas" width="800" height="600" style="-fx-border-color: black; -fx-background-color: white;"/>
        </StackPane>
    </center>
    <bottom>
        <HBox spacing="20" alignment="CENTER" style="-fx-padding: 10;">
            <!-- Restart Button -->
            <Button fx:id="restartButton" text="Restart" minWidth="100" minHeight="40" onAction="#handleRestart"/>
            <!-- Export Button -->
            <Button fx:id="exportButton" text="Exportieren" minWidth="100" minHeight="40" onAction="#handleExport"/>
        </HBox>
    </bottom>
</BorderPane>
